# Optional. The app is bring-your-own-key: each user pastes their Gemini API key
# in the sidebar (kept in their session only), so no API key is configured here.

# Override the Gemini model id (default: gemini-2.5-flash). Can also be set in
# .streamlit/secrets.toml as GEMINI_MODEL = "...".
# GEMINI_MODEL=gemini-2.5-flash
